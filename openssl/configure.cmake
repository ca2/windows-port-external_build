include("${SETTINGS_FILE}")
get_filename_component(compiler_directory "${CMAKE_C_COMPILER}" DIRECTORY)
set(arguments shared "--prefix=${OPENSSL_INSTALL_DIR}" "--openssldir=${OPENSSL_INSTALL_DIR}/ssl" --libdir=lib)
if(NOT OPENSSL_ASM)
    list(APPEND arguments no-asm)
endif()
if(NOT OPENSSL_RUN_TESTS)
    list(APPEND arguments no-tests)
endif()
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    list(APPEND arguments --debug)
else()
    list(APPEND arguments --release)
endif()
list(APPEND arguments ${OPENSSL_EXTRA_CONFIGURE_ARGS})
if(PHASE STREQUAL "configure")
    file(READ "${SOURCE_DIR}/VERSION.dat" version_data)
    foreach(part IN ITEMS MAJOR MINOR PATCH)
        string(REGEX MATCH "${part}=([0-9]+)" unused "${version_data}")
        set(version_${part} "${CMAKE_MATCH_1}")
    endforeach()
    if(NOT "${version_MAJOR}.${version_MINOR}.${version_PATCH}" STREQUAL OPENSSL_VERSION)
        message(FATAL_ERROR "OpenSSL sources do not match OPENSSL_VERSION=${OPENSSL_VERSION}")
    endif()
endif()
if(MSVC)
    # Dependency scans (/Zs) can fail opening OpenSSL's compiler PDB even
    # with /FS. Embedded CodeView avoids that PDB; the linker still emits PDBs.
    # _CL_ is appended after command-line /Zi, so /Z7 takes precedence.
    set(ENV{CL} "/FS $ENV{CL}")
    set(ENV{_CL_} "$ENV{_CL_} /Z7")
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        # Produce matching DLL/PDB pairs even when NMake links again at install.
        set(ENV{_LINK_} "$ENV{_LINK_} /INCREMENTAL:NO")
    endif()
    set(ENV{LC_ALL} "C")
    get_filename_component(perl_directory "${OPENSSL_PERL}" DIRECTORY)
    set(ENV{PATH} "${compiler_directory};${perl_directory};$ENV{PATH}")
    if(OPENSSL_ASM)
        get_filename_component(nasm_directory "${OPENSSL_NASM}" DIRECTORY)
        set(ENV{PATH} "${nasm_directory};$ENV{PATH}")
    endif()
    if(CMAKE_C_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64")
        set(target VC-WIN64-ARM)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(target VC-WIN64A)
    else()
        set(target VC-WIN32)
    endif()
    if(PHASE STREQUAL "configure")
        if(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
            list(APPEND arguments "CFLAGS=/O2 /Zi" "LDFLAGS=/DEBUG")
        elseif(CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
            list(APPEND arguments "CFLAGS=/O1")
        endif()
        execute_process(COMMAND "${OPENSSL_PERL}" "${SOURCE_DIR}/Configure" ${target} ${arguments}
            WORKING_DIRECTORY "${BINARY_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    elseif(PHASE STREQUAL "build")
        execute_process(COMMAND "${OPENSSL_MAKE}" /NOLOGO WORKING_DIRECTORY "${BINARY_DIR}" COMMAND_ERROR_IS_FATAL ANY)
        if(OPENSSL_RUN_TESTS)
            execute_process(COMMAND "${OPENSSL_MAKE}" /NOLOGO test WORKING_DIRECTORY "${BINARY_DIR}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
    elseif(PHASE STREQUAL "install")
        execute_process(COMMAND "${OPENSSL_MAKE}" /NOLOGO install_sw install_ssldirs
            WORKING_DIRECTORY "${BINARY_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        message(FATAL_ERROR "Unknown OpenSSL phase: ${PHASE}")
    endif()
else()
    function(shell_quote output value)
        string(REPLACE "'" "'\"'\"'" value "${value}")
        set(${output} "'${value}'" PARENT_SCOPE)
    endfunction()
    shell_quote(compiler_q "${compiler_directory}")
    shell_quote(binary_q "${BINARY_DIR}")
    set(command "set -eu; export LC_ALL=C; export PATH=\"$(/usr/bin/cygpath -u ${compiler_q}):/usr/bin:$PATH\"; cd ${binary_q}; ")
    if(PHASE STREQUAL "configure")
        if(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(target mingw64)
        else()
            set(target mingw)
        endif()
        list(APPEND arguments "CC=${CMAKE_C_COMPILER}" "AR=${CMAKE_AR}" "RANLIB=${CMAKE_RANLIB}"
            "WINDRES=${compiler_directory}/windres.exe")
        if(__REACTOS__)
            list(APPEND arguments -D__REACTOS__ -D_WIN32_WINNT=0x0501 -DWINVER=0x0501)
        endif()
        if(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
            list(APPEND arguments -g)
        elseif(CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
            list(APPEND arguments -Os)
        endif()
        shell_quote(source_q "${SOURCE_DIR}/Configure")
        string(APPEND command "exec /usr/bin/perl ${source_q} ${target}")
        foreach(argument IN LISTS arguments)
            shell_quote(argument_q "${argument}")
            string(APPEND command " ${argument_q}")
        endforeach()
    elseif(PHASE STREQUAL "build")
        string(APPEND command "/usr/bin/make -j${OPENSSL_JOBS}")
        if(OPENSSL_RUN_TESTS)
            string(APPEND command " && /usr/bin/make test")
        endif()
    elseif(PHASE STREQUAL "install")
        string(APPEND command "exec /usr/bin/make install_sw install_ssldirs")
    else()
        message(FATAL_ERROR "Unknown OpenSSL phase: ${PHASE}")
    endif()
    execute_process(COMMAND "${OPENSSL_BASH}" -lc "${command}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(PHASE STREQUAL "install")
    if(MSVC)
        file(GLOB symbols "${BINARY_DIR}/*.pdb")
        if(symbols)
            file(COPY ${symbols} DESTINATION "${OPENSSL_INSTALL_DIR}/bin")
        endif()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/verify.cmake")
endif()

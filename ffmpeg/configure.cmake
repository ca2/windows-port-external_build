include("${SETTINGS_FILE}")
function(shell_quote output value)
    string(REPLACE "'" "'\"'\"'" value "${value}")
    set(${output} "'${value}'" PARENT_SCOPE)
endfunction()
get_filename_component(compiler_directory "${CMAKE_C_COMPILER}" DIRECTORY)
if(NOT MSVC AND EXISTS "${compiler_directory}/windres.exe")
    # CMake may otherwise find an unrelated Perl/Strawberry windres on PATH.
    set(CMAKE_RC_COMPILER "${compiler_directory}/windres.exe")
endif()
shell_quote(compiler_directory_q "${compiler_directory}")
shell_quote(binary_directory_q "${BINARY_DIR}")
set(command "export PATH=\"$(/usr/bin/cygpath -u ${compiler_directory_q}):/usr/bin:$PATH\"; cd ${binary_directory_q} && ")
if(PHASE STREQUAL "configure")
    set(configure_script "${SOURCE_DIR}/configure")
    set(arguments "--prefix=${FFMPEG_INSTALL_DIR}" --disable-autodetect --disable-doc
        --enable-shared --disable-static --enable-avutil --enable-swresample
        --enable-avcodec --enable-avformat --enable-swscale)
    if(MSVC)
        # Upstream's MSVC flag filter translates -g to -Z7, but not -g3.
        set(debug_option --enable-debug)
    else()
        set(debug_option --enable-debug=3)
    endif()
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        list(APPEND arguments ${debug_option} --disable-stripping
            --disable-optimizations --disable-inline-asm)
    elseif(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
        list(APPEND arguments ${debug_option} --disable-stripping)
    elseif(CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
        list(APPEND arguments --disable-debug --enable-small)
    else()
        list(APPEND arguments --disable-debug)
    endif()
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
        list(APPEND arguments --arch=x86)
    else()
        list(APPEND arguments --arch=x86_64)
    endif()
    if(FFMPEG_BUILD_PROGRAMS)
        list(APPEND arguments --enable-ffmpeg --enable-ffprobe --disable-ffplay --enable-avfilter --enable-avdevice)
    else()
        list(APPEND arguments --disable-programs --disable-avfilter --disable-avdevice)
    endif()
    if(NOT FFMPEG_NETWORK)
        list(APPEND arguments --disable-network)
    endif()
    if(MSVC)
        # CMake must be launched from a VS developer prompt with INCLUDE/LIB/SDK.
        list(APPEND arguments --target-os=win32 --toolchain=msvc
            --cc=cl.exe --ar=lib.exe --disable-stripping)
    else()
        list(APPEND arguments --target-os=mingw32 --enable-cross-compile
            "--cc=${CMAKE_C_COMPILER}" "--ar=${CMAKE_AR}" "--ranlib=${CMAKE_RANLIB}"
            "--nm=${CMAKE_NM}" "--strip=${CMAKE_STRIP}" "--windres=${CMAKE_RC_COMPILER}")
        if(EXISTS "${compiler_directory}/nasm.exe")
            list(APPEND arguments "--x86asmexe=${compiler_directory}/nasm.exe")
        endif()
    endif()
    if(__REACTOS__)
        file(READ "${SOURCE_DIR}/configure" configure_source)
        shell_quote(source_directory_q "${SOURCE_DIR}")
        string(REPLACE "source_path=$(cd $(dirname \"$0\"); pwd)"
            "source_path=$(cd ${source_directory_q}; pwd)" configure_source "${configure_source}")
        string(REPLACE "_WIN32_WINNT < 0x0600" "_WIN32_WINNT < 0x0501" configure_source "${configure_source}")
        string(REPLACE "add_\${pfx}cppflags -D_WIN32_WINNT=0x0600"
            "add_\${pfx}cppflags -D_WIN32_WINNT=0x0501" configure_source "${configure_source}")
        # BCrypt is unavailable on XP; retain upstream's generic seed fallback.
        string(REPLACE "check_lib bcrypt   \"windows.h bcrypt.h\"   BCryptGenRandom      -lbcrypt &&\n    check_cpp_condition bcrypt bcrypt.h \"defined BCRYPT_RNG_ALGORITHM\""
            "disable bcrypt" configure_source "${configure_source}")
        set(configure_script "${BINARY_DIR}/configure-xp")
        file(WRITE "${configure_script}" "${configure_source}")
        list(APPEND arguments --cpu=i686 --enable-pthreads --disable-w32threads --disable-os2threads
            "--extra-cflags=-D__REACTOS__ -D_WIN32_WINNT=0x0501 -DWINVER=0x0501 -include ${CMAKE_CURRENT_LIST_DIR}/ffmpeg-xp-compat.h"
            --extra-ldflags=-static-libgcc)
    endif()
    list(APPEND arguments ${FFMPEG_EXTRA_CONFIGURE_ARGS})
    shell_quote(configure_script_q "${configure_script}")
    string(APPEND command "exec /usr/bin/bash ${configure_script_q}")
    foreach(argument IN LISTS arguments)
        shell_quote(argument_q "${argument}")
        string(APPEND command " ${argument_q}")
    endforeach()
elseif(PHASE STREQUAL "build")
    string(APPEND command "exec /usr/bin/make -j${FFMPEG_JOBS}")
    if(NOT MSVC)
        shell_quote(windres_q "WINDRES=${CMAKE_RC_COMPILER}")
        string(APPEND command " ${windres_q}")
    endif()
elseif(PHASE STREQUAL "install")
    if(FFMPEG_BUILD_PROGRAMS)
        string(APPEND command "exec /usr/bin/make install")
    else()
        string(APPEND command "exec /usr/bin/make install-libs install-headers")
    endif()
else()
    message(FATAL_ERROR "Unknown FFmpeg phase: ${PHASE}")
endif()
execute_process(COMMAND "${FFMPEG_BASH}" -lc "${command}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "FFmpeg ${PHASE} failed: ${result}; see ExternalProject logs and build/ffbuild/config.log")
endif()

# Stage compiler runtimes beside the DLLs. XP needs a winpthread built for XP;
# using the matching compiler directory avoids accidentally taking a host copy.
if(PHASE STREQUAL "install" AND NOT MSVC)
    file(GLOB runtime_dlls "${compiler_directory}/libwinpthread-1.dll"
        "${compiler_directory}/libgcc_s_*.dll" "${compiler_directory}/libatomic-1.dll")
    if(runtime_dlls)
        file(COPY ${runtime_dlls} DESTINATION "${FFMPEG_INSTALL_DIR}/bin")
    endif()
endif()
if(PHASE STREQUAL "install" AND MSVC)
    file(GLOB debug_symbols "${BINARY_DIR}/lib*/*.pdb" "${BINARY_DIR}/*.pdb")
    if(debug_symbols)
        file(COPY ${debug_symbols} DESTINATION "${FFMPEG_INSTALL_DIR}/bin")
    endif()
endif()